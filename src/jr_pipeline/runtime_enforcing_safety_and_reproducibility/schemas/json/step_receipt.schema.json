{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jr-pipeline/schemas/step_receipt.schema.json",
  "title": "Stage Receipt",
  "description": "Authoritative audit record for one extraction stage. Stores the full rendered messages as sent to the LLM plus the template pointer + context vars so reconstruction is possible. Required fields depend on stage kind — the runner fills them from its StageResult.",
  "allOf": [{"$ref": "artifact_envelope.schema.json"}],
  "properties": {
    "artifact_type": {"const": "step_receipt"},
    "sensitivity": {"const": "high"},
    "stream": {"const": "data"},
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "retrieve_and_prompt",
            "map_table_rows_and_prompt",
            "llm_only",
            "direct_parquet",
            "python"
          ]
        },
        "retrieval": {
          "type": "object",
          "properties": {
            "kind": {"type": "string"},
            "version": {"type": "string"},
            "config": {"type": "object"},
            "candidates": {"type": "array"},
            "score_normalization": {"type": "string"},
            "elapsed_s": {"type": "number"}
          }
        },
        "evidence": {
          "type": "object",
          "properties": {
            "bundle_size": {"type": "integer"},
            "chunks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["chunk_id", "text"],
                "properties": {
                  "chunk_id": {"type": "string"},
                  "rank": {"type": "integer"},
                  "score": {"type": "number"},
                  "text": {"type": "string"}
                }
              }
            }
          }
        },
        "prompt": {
          "type": "object",
          "required": ["template_name", "template_hash"],
          "properties": {
            "template_name": {"type": "string"},
            "template_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "context_vars": {"type": "object"}
          }
        },
        "messages_sent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": {"type": "string", "enum": ["system", "user", "assistant"]},
              "content": {"type": "string"}
            }
          }
        },
        "resolved_model": {
          "description": "The model that answered. Null when no evidence reached a model, so no call was made — an empty retrieval must record an honest receipt, not fail the step and cut off the recipe's fallback passes.",
          "type": ["object", "null"],
          "required": ["endpoint_name", "api_model_id", "fingerprint"],
          "properties": {
            "endpoint_name":   {"type": "string"},
            "api_model_id":    {"type": "string"},
            "api_version":     {"type": ["string", "null"]},
            "deployment_name": {"type": ["string", "null"]},
            "fingerprint":     {"type": "string"}
          }
        },
        "response_raw":    {"type": ["object", "array", "string", "null"]},
        "response_parsed": {"type": ["object", "array", "null"]},
        "validation": {"type": "object"},
        "retries": {"type": "array"},
        "timings": {"type": "object"},
        "python_helper": {"type": "object"},
        "table": {"type": "string"},
        "row_count": {"type": "integer"},
        "columns_requested": {"type": ["array", "null"]},
        "missing": {"type": "boolean"},
        "elapsed_s": {"type": "number"}
      }
    }
  }
}
