# jr_pipeline — example environment variables
# Copy to .env (gitignored) for local development.
#
# The pipeline refuses to connect to public consumer LLM APIs regardless of
# what is set here. See docs/phi_governance.md. The LLM endpoint allowlist is
# NOT an env var — it is the `allowlist_path` key in the run config (an
# institutional allowlist lives outside this repo).

# ------------------------------------------------------------------------
# Required for any run
# ------------------------------------------------------------------------

# Root of the data tree (CONTAINS_PHI/ + NO_PHI__shareable/ live under it).
# Relocatable — point at a network mount or SLURM scratch.
JR_DATA_ROOT=./data

# ------------------------------------------------------------------------
# Optional — HuggingFace model cache (dev lane only; production models are
# pinned local directories and never download)
# ------------------------------------------------------------------------

# Local cache for auto-downloaded dev models. On a cluster, point at a shared lab path.
HF_HOME=

# Always 1 on compute nodes without internet egress.
HF_HUB_OFFLINE=0

# Keep false to silence tokenizer fork warnings in multi-process contexts.
TOKENIZERS_PARALLELISM=false

# Only needed if a dev endpoint downloads a gated HuggingFace model. Never committed.
HF_TOKEN=

# ------------------------------------------------------------------------
# Optional — output redaction (see docs/phi_governance.md)
# ------------------------------------------------------------------------

# Extracted values are redacted from stdout by default. Set to 1 ONLY for
# synthetic-fixture runs where seeing values on screen is safe.
JR_SHOW_STDOUT_VALUES=

# Set to any non-empty value to force redaction even if JR_SHOW_STDOUT_VALUES is set.
JR_REDACT_STDOUT=
